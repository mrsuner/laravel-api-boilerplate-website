---
const { pathname } = Astro.url;
const isDocs = pathname.startsWith('/docs');
const isPackages = pathname.startsWith('/packages');
---

<header class="sticky top-0 z-50 border-b border-base-300 bg-base-100/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 font-bold tracking-tight">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-primary text-primary-content text-sm font-black">L</span>
      <span class="hidden sm:inline">Laravel API Boilerplate</span>
      <span class="sm:hidden">LAB</span>
    </a>

    <nav class="ml-auto flex items-center gap-1 text-sm font-medium">
      <a
        href="/"
        class={`btn btn-ghost btn-sm ${!isDocs ? 'text-primary' : ''}`}
      >Home</a>
      <a
        href="/docs/introduction"
        class={`btn btn-ghost btn-sm ${isDocs ? 'text-primary' : ''}`}
      >Docs</a>
      <a
        href="/packages/laravel-coupon/introduction"
        class={`btn btn-ghost btn-sm ${isPackages ? 'text-primary' : ''}`}
      >Packages</a>
      <a
        href="https://github.com"
        target="_blank"
        rel="noreferrer"
        class="btn btn-sm btn-neutral"
      >GitHub</a>
    </nav>
  </div>
</header>
