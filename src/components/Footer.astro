---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="border-t border-base-300 bg-base-100">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-5">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2.5 font-bold">
        <span class="grid h-8 w-8 place-items-center rounded-lg bg-primary text-primary-content text-sm font-black">L</span>
        Laravel API Boilerplate
      </div>
      <p class="mt-3 max-w-sm text-sm text-base-content/60">
        A production-ready Laravel 13 starter for RESTful APIs with auth, RBAC,
        files, audit and Docker, all driven from one config file.
      </p>
    </div>

    <div>
      <h3 class="text-sm font-semibold">Documentation</h3>
      <ul class="mt-3 space-y-2 text-sm text-base-content/70">
        <li><a class="hover:text-primary" href={`${base}/docs/introduction`}>Introduction</a></li>
        <li><a class="hover:text-primary" href={`${base}/docs/installation`}>Installation</a></li>
        <li><a class="hover:text-primary" href={`${base}/docs/authentication`}>Authentication</a></li>
        <li><a class="hover:text-primary" href={`${base}/docs/files`}>File Uploads</a></li>
        <li><a class="hover:text-primary" href={`${base}/changelog`}>Changelog</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold">Official Packages</h3>
      <ul class="mt-3 space-y-2 text-sm text-base-content/70">
        <li><a class="hover:text-primary" href={`${base}/packages/laravel-coupon/introduction`}>laravel-coupon</a></li>
        <li><a class="hover:text-primary" href={`${base}/packages/laravel-coupon/coupon-service`}>CouponService API</a></li>
        <li><a class="hover:text-primary" href={`${base}/packages/laravel-api-keys/introduction`}>laravel-api-keys</a></li>
        <li><a class="hover:text-primary" href={`${base}/packages/laravel-api-keys/api-key-service`}>ApiKeyService API</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold">Resources</h3>
      <ul class="mt-3 space-y-2 text-sm text-base-content/70">
        <li><a class="hover:text-primary" href="https://laravel.com" target="_blank" rel="noreferrer">Laravel</a></li>
        <li><a class="hover:text-primary" href="https://scribe.knuckles.wtf" target="_blank" rel="noreferrer">Scribe</a></li>
        <li><a class="hover:text-primary" href="https://laratrust.santigarcor.me" target="_blank" rel="noreferrer">Laratrust</a></li>
        <li><a class="hover:text-primary" href="https://github.com/mrsuner/laravel-api-boilerplate" target="_blank" rel="noreferrer">GitHub</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-base-300">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-5 text-xs text-base-content/70 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>© {year} Laravel API Boilerplate. Released under the MIT License.</p>
      <p>
        Made with ❤️ by{' '}
        <a class="font-medium hover:text-primary" href="https://soft.pw" target="_blank" rel="noopener noreferrer">
          Luke
        </a>
        {' '}· Powered by{' '}
        <a class="font-medium hover:text-primary" href="https://alphablueth.com" target="_blank" rel="noopener noreferrer">
          AlphaBlue
        </a>
      </p>
    </div>
  </div>
</footer>
