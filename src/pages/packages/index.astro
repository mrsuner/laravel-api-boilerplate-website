---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PACKAGES, getPackageNav } from '../../data/nav';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Pull each package's first doc page (for the primary CTA) and its section
// groups (to preview what's documented).
const packages = await Promise.all(
  PACKAGES.map(async (pkg) => {
    const nav = await getPackageNav(pkg.slug);
    const flat = nav.flatMap((g) => g.items);
    const first = flat[0];
    return {
      ...pkg,
      href: first ? `${base}/packages/${first.slug}` : `${base}/packages/${pkg.slug}`,
      pageCount: flat.length,
      sections: nav.map((g) => g.section),
    };
  }),
);
---

<BaseLayout
  title="Official Packages"
  description="First-party packages that follow the same conventions and auto-wire into the Laravel API Boilerplate."
>
  <section class="border-b border-base-300 bg-base-200/40">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <span class="badge badge-primary badge-outline">Official packages</span>
      <h1 class="mt-4 text-4xl font-bold tracking-tight">Extend the boilerplate</h1>
      <p class="mt-3 max-w-2xl text-base-content/65">
        Drop-in packages that follow the same conventions and auto-wire into the
        boilerplate's admin stack — and install on any Laravel 12/13 app too.
        Each ships its own focused docs.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <div class="grid gap-6 md:grid-cols-2">
      {
        packages.map((pkg) => (
          <div class="card border border-base-300 bg-base-100 transition-colors hover:border-primary">
            <div class="card-body gap-4 p-7">
              <div class="flex items-center gap-3">
                <span class="grid h-11 w-11 place-items-center rounded-lg bg-primary text-primary-content text-lg font-black">
                  {pkg.badge}
                </span>
                <div class="min-w-0">
                  <h2 class="card-title text-lg">{pkg.name}</h2>
                  <p class="text-xs text-base-content/50">
                    {pkg.pageCount} docs · {pkg.sections.join(' · ')}
                  </p>
                </div>
              </div>

              <p class="text-sm text-base-content/70">{pkg.tagline}</p>

              <div class="mt-1 flex flex-wrap gap-2">
                <a href={pkg.href} class="btn btn-primary btn-sm">
                  Read the docs
                </a>
                <a
                  href={pkg.repo}
                  target="_blank"
                  rel="noreferrer"
                  class="btn btn-outline btn-sm"
                >
                  GitHub
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
